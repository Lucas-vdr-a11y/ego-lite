{
  "name": "ego-browser-v2",
  "version": "0.1.0",
  "description": "TaskSpace control and native Playwright integration for ego-browser.",
  "type": "module",
  "imports": {
    "#playwright-runtime": "./playwright-runtime.cjs",
    "#playwright-transport": "./playwright-transport.cjs"
  },
  "bin": {
    "ego-browser": "./dist/out/index.js"
  },
  "workspaces": [
    "test/real-browser-e2e/site"
  ],
  "scripts": {
    "clean": "rm -rf dist artifacts",
    "build": "node scripts/build.mjs && npm --workspace ego-browser-test-site run build",
    "e2e": "node scripts/run-real-browser-e2e.mjs",
    "e2e:native-close": "EGO_BROWSER_REAL_E2E_ONLY='native task space close regression' node scripts/run-real-browser-e2e.mjs",
    "e2e:process-contention": "EGO_BROWSER_REAL_E2E_ONLY='TaskSpace process contention' node scripts/run-real-browser-e2e.mjs",
    "prepare": "if [ \"$CI\" = \"true\" ]; then exit 0; fi; cd ../.. && lefthook install",
    "style:check": "prettier --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && node --test \"src/**/*.test.mjs\" \"test/**/*.test.js\"",
    "mutation-check": "npm run build && node scripts/mutation-check.mjs",
    "validate:agent-style": "node scripts/validate-agent-style.mjs",
    "validate:learnings": "npm run build && EGO_BROWSER_AGENT_WORKSPACE=../../skills/ego-browser node dist/scripts/validate-site-skills.js",
    "validate:site-skills": "npm run build && EGO_BROWSER_AGENT_WORKSPACE=../../skills/ego-browser node dist/scripts/validate-site-skills.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.15.29",
    "esbuild": "^0.28.1",
    "fast-xml-parser": "^5.2.5",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "playwright-core": "1.52.0"
  },
  "overrides": {
    "hono": "4.13.0",
    "@hono/vite-dev-server": {
      "@hono/node-server": "2.0.12"
    }
  }
}
